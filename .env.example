# Copy this file to .env.local and fill in the values.
# Supabase dashboard → Project Settings → API Keys (or "Connect" button on the project home).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_...). The legacy "anon" key also works.
# It's safe to expose to the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Google Cloud → Google Auth Platform → Clients → your Web client. The client ID is public;
# the client secret goes only in Supabase (Authentication → Providers → Google), never here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Bangla translation of selected text (Google Gemini, free tier — no card needed).
# aistudio.google.com/apikey → Create API key. Server only: never prefix with NEXT_PUBLIC_.
# Free-tier requests may be used by Google to improve its models.
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-lite-latest (fast, highest free limits).
GEMINI_MODEL=
